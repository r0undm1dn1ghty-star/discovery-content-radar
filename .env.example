# ===== Clone: NO Apify, NO TubeLab =====

# X/Twitter - twitterapi.io (the only paid service here)
# Get your key at https://twitterapi.io -> $0.15 per 1,000 tweets, $1 free credit on signup
XAPI_TOKEN=your-twitterapi-io-key-here

# Instagram - instaloader, YOUR OWN account (one-time login, creates a session file)
# Run: python -m instaloader --login YOUR_IG_USERNAME
# Then set both vars (session file is searched in IG_SESSION_DIR):
IG_SESSION_USER=your_ig_username
IG_SESSION_DIR=.

# TikTok - tikwm.com free API: no key needed

# YouTube - yt-dlp + youtube-transcript-api: no key needed

# Video Analysis - Gemini (free tier is enough)
# Get your token from https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-key
